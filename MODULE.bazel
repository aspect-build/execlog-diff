module(
    name = "execlog_diff",
    version = "0.0.0",
)

# rules_go: pinned commit for Bazel 9 + macOS compatibility
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "llvm", version = "0.7.7")

register_toolchains("@llvm//toolchain:all")

osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.frameworks(names = [
    "CFNetwork",
    "CoreFoundation",
    "CoreServices",
    "Foundation",
    "IOKit",
    "Security",
    "SystemConfiguration",
])

bazel_dep(name = "rules_go", version = "0.60.0", repo_name = "io_bazel_rules_go")
archive_override(
    module_name = "rules_go",
    integrity = "sha256-8ezQcDyHHp/+xa9NbUJO/3/kDEFFmJaV4pb1fd99m74=",
    strip_prefix = "rules_go-62d798d48ae153e048a7f9c43ba68cfa1ea10924",
    url = "https://github.com/bazel-contrib/rules_go/archive/62d798d48ae153e048a7f9c43ba68cfa1ea10924.tar.gz",
)

bazel_dep(name = "gazelle", version = "0.43.0", repo_name = "bazel_gazelle")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "tar.bzl", version = "0.7.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "33.4", repo_name = "com_google_protobuf")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.0")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_klauspost_compress",
    "com_github_onsi_gomega",
    "com_github_spf13_cobra",
    "org_golang_google_protobuf",
    "tools_gotest_v3",
)

tar_toolchains = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains")
use_repo(tar_toolchains, "bsd_tar_toolchains")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "execlog_diff_testdata_execlogs",
    downloaded_file_path = "execlogs.tar.gz",
    sha256 = "4340031c1fd7d43faeabe12f6afc4a259590c51abf2fe43f5e18cf79f87d590e",
    urls = ["https://github.com/aspect-build/execlog-diff/releases/download/test-data-0.0.1/test-execlogs.tar.gz"],
)
