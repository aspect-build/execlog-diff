load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("//bazel/go:write_go_generated_source_files.bzl", "write_go_generated_source_files")

go_library(
    name = "diagnostic_go_proto",
    srcs = ["diagnostic.pb.go"],
    importpath = "github.com/aspect-build/execlog-diff/diagnostic",
    visibility = ["//visibility:public"],
    deps = [
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//runtime/protoimpl",
    ],
)

proto_library(
    name = "diagnostic_proto",
    srcs = ["diagnostic.proto"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "diagnostic_go_proto_gen",
    importpath = "github.com/aspect-build/execlog-diff/diagnostic",
    proto = ":diagnostic_proto",
    visibility = ["//visibility:public"],
)

write_go_generated_source_files(
    name = "write_pb_go",
    src = ":diagnostic_go_proto_gen",
    output_files = [
        "diagnostic.pb.go",
    ],
    visibility = ["//visibility:public"],
)
