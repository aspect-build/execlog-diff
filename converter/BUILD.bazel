load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "converter",
    srcs = ["converter.go"],
    importpath = "github.com/aspect-build/execlog-diff/converter",
    visibility = ["//visibility:public"],
    deps = [
        "//context",
        "//converter/compact",
        "//converter/compact/decompress",
        "//types",
        "//diagnostic:diagnostic_go_proto",
    ],
)

go_test(
    name = "converter_test",
    srcs = ["converter_test.go"],
    data = [
        "//test-data:execlogs",
    ] + glob(["testdata/**/*"]),
    embed = [":converter"],
    deps = [
        "//context",
        "//test-data/helpers",
        "//types",
        "//diagnostic:diagnostic_go_proto",
        "@com_github_onsi_gomega//:gomega",
        "@tools_gotest_v3//golden",
    ],
)
